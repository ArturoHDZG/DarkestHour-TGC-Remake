# Treat Darkest Hour game data files cleanly across macOS / Windows / Linux
* text=auto

# Keep Paradox text/CSV files as CRLF or untouched binary-safe Latin-1 so accents & columns never break
*.csv text eol=crlf
*.txt text eol=crlf
*.eug text eol=crlf
*.inc text eol=crlf
*.ai text eol=crlf

# Repo documentation & scripts
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf

# Binary assets (do NOT apply line-ending conversion!)
*.bmp binary
*.png binary
*.ico binary
*.jpg binary
*.wav binary
*.mp3 binary
*.ogg binary
*.exe binary
